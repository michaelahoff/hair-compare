# Copy to .env and fill in from your Supabase project (Settings → API).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-or-anon-key

# Development builds only; production builds ignore this. Sends analyses to the
# developer server in scripts/dev-analysis-server (run it with `npm run dev:analysis`).
# Android emulators also need: adb reverse tcp:8787 tcp:8787
# EXPO_PUBLIC_ANALYSIS_URL=http://127.0.0.1:8787
